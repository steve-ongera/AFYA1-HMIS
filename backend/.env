# =============================================================================
#  AFYA1 HMIS — Environment Variables
#  South B Hospital Management Information System
#
#  Copy this file to .env and fill in real values before running.
#  NEVER commit .env to version control.
# =============================================================================


# ── Core Django ───────────────────────────────────────────────────────────────

# Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-s0uth-b-h0sp1tal-afya1-hm1s-replace-me-in-pr0duct10n-!!!

DEBUG=True

# Comma-separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1

# Must match your frontend dev server
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — development)
# No extra config needed; DB file created at BASE_DIR/db.sqlite3

# PostgreSQL (production) — uncomment and fill when ready:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=afya1_hmis
# DB_USER=afya1_user
# DB_PASSWORD=Afya1_Str0ng_Pass!
# DB_HOST=localhost
# DB_PORT=5432


# ── Media Files ───────────────────────────────────────────────────────────────

MEDIA_ROOT=media


# ── API Pagination ────────────────────────────────────────────────────────────

API_PAGE_SIZE=25


# ── JWT Token Lifetimes ───────────────────────────────────────────────────────

JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7


# ── Throttling ────────────────────────────────────────────────────────────────

THROTTLE_ANON=100/hour
THROTTLE_USER=2000/hour
THROTTLE_LOGIN=10/minute


# ── CORS ──────────────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173


# ── Redis / Caching ───────────────────────────────────────────────────────────
# Set USE_REDIS_CACHE=True only if Redis is running
USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/1


# ── Logging ───────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
USE_JSON_LOGGING=False


# ── Email ─────────────────────────────────────────────────────────────────────
# Development: prints emails to console (no SMTP needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP (Gmail example) — uncomment and fill:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=afya1.hmis@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password-here

DEFAULT_FROM_EMAIL=AFYA1 HMIS <noreply@southb.hospital>


# ── SSL / Security (production only) ─────────────────────────────────────────
# Leave False in development, set True behind HTTPS in production
SECURE_SSL_REDIRECT=False


# ── SHA — Social Health Authority ─────────────────────────────────────────────

SHA_API_BASE_URL=https://api.sha.go.ke/v1
SHA_API_KEY=sha-test-api-key-replace-with-real-key
SHA_FACILITY_CODE=KE-047-5001
SHA_TEST_MODE=True
SHA_TIMEOUT_SECONDS=30


# ── eTIMS — KRA Electronic Tax Invoice Management ─────────────────────────────

ETIMS_API_BASE_URL=https://etims.kra.go.ke/api
ETIMS_TEST_URL=https://etims-dev.kra.go.ke/api
ETIMS_TEST_MODE=True
ETIMS_TIMEOUT=30


# ── M-Pesa / Daraja (Safaricom) ───────────────────────────────────────────────
# Get credentials from https://developer.safaricom.co.ke
# Use sandbox values for development

MPESA_ENVIRONMENT=sandbox

# Sandbox test credentials (replace with real ones for production)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key-here
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret-here

# Lipa Na M-Pesa Online (STK Push)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Must be a publicly accessible URL (use ngrok in development)
# e.g. https://abc123.ngrok.io/api/mpesa/callback/
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/mpesa/callback/


# ── Hospital Identity ─────────────────────────────────────────────────────────

HOSPITAL_NAME=South B Hospital
HOSPITAL_LEVEL=Level 5
HOSPITAL_ADDRESS=South B Estate, Nairobi, Kenya
HOSPITAL_PHONE=+254 20 555 0100
HOSPITAL_EMAIL=info@southbhospital.co.ke